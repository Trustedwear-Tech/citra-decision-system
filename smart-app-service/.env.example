MONGO_URI=mongodb://root:citradev@localhost:37017/dev?authSource=admin
MONGO_DB=dev
# Must match Citra-Service JWT_SECRET / JWT_ISSUER for cross-service auth.
JWT_SECRET=change-me
JWT_ISSUER=Citra-AI
# action-sandbox-host listens on :7090 with network_mode=host. On a
# single VM use host.docker.internal (Win/Mac) or 172.17.0.1 (Linux).
SANDBOX_HOST_URL=http://host.docker.internal:7090
SANDBOX_HOST_SECRET=change-me-must-match-action-sandbox-host
DISCOVERY_SERVICE_URL=http://localhost:9000
CITRA_SERVICE_URL=http://localhost:8085
# citra-workflow runs as its own service post Phase J split.
# Must be set explicitly — no fallback to CITRA_SERVICE_URL.
WORKFLOW_SERVICE_URL=http://localhost:9200
APPS_BASE_URL=https://apps.citra-ai.com
PORT=9100
ENVIRONMENT=dev

# -----------------------------------------------------------------------------
# Large LLM. Same trust model as VISION_*: the API key NEVER leaves
# smart-app-service. The builder pod (and its action-sandbox runner)
# call our internal proxy /smart-app/internal/llm/v1/chat/completions
# with a short-lived HMAC bearer instead of holding the raw OpenRouter
# / inference-service key. The proxy enforces the model allowlist and
# per-session call/token budgets below before relaying to LLM_LARGE_BASE_URL.
# Same names as Citra-Service / action-chat-service so one .env block
# configures all three. The builder skills (citra-app-spec,
# citra-agent-spec, citra-dashboard-spec) make heavy reasoning calls —
# point this at a GLM-5.1 class model.
# -----------------------------------------------------------------------------
LLM_LARGE_BASE_URL=https://openrouter.ai/api/v1
LLM_LARGE_API_KEY=<copy from Citra-Service or action-chat-service .env>
LLM_LARGE_MODEL=deepseek/deepseek-v4-pro
# Optional — DeepSeek V4 Pro native window is 1,000,000; set just under 1M for
# output headroom. Override if you swap to a model with a smaller context.
LLM_CONTEXT_WINDOW=960000
LLM_MAX_OUTPUT_TOKENS=32768

# Bounds the blast radius of a compromised / prompt-injected builder
# session. Per-process, in-memory counters keyed by build_session_id;
# promote to Redis if smart-app-service is horizontally scaled.
SMART_APP_LLM_PROXY_MAX_CALLS_PER_SESSION=1000
SMART_APP_LLM_PROXY_MAX_TOKENS_PER_SESSION=10000000
# Comma-separated; if empty, only LLM_LARGE_MODEL is allowed through
# the proxy. Add aliases here when you want the builder to be able to
# fall back to a cheaper model, e.g. "deepseek/deepseek-chat-v3.1".
SMART_APP_LLM_PROXY_ALLOWED_MODELS=

# -----------------------------------------------------------------------------
# Cost & rate limits (operator ceilings — values shown are the code defaults)
# -----------------------------------------------------------------------------
# Per-USER LLM-call rate limit (run / chat / sub-agent / trigger all count).
# Over the limit → HTTP 429. Shared across instances via Redis (REDIS_*).
# Set to your LLM/GPU budget; a run makes ~5–12 calls, so 30 ≈ 3–6 runs/user/min.
LLM_CALLS_PER_USER_PER_MINUTE=30
LLM_RATE_WINDOW_SECONDS=60

# Per-RUN token budget — caps one agent run (over → forced final synthesis).
SMART_APP_RUN_MAX_TOKENS=200000

# Trigger fan-out (poll) — operator ceilings a BA cannot raise. Small to protect
# a shared LLM: at most N new rows per scheduler tick, concurrency-at-a-time.
TRIGGER_MAX_POLL_ROWS_PER_TICK=5
TRIGGER_POLL_CONCURRENCY=1

# Minimum cadence for ALL timer triggers (cron / interval / poll), seconds.
# 5-minute floor; enforced at PATCH + publish + clamped at runtime.
MIN_TRIGGER_INTERVAL_SECONDS=300

# Background scheduler: OFF unless set truthy (1/true/yes); tick cadence in sec.
SCHEDULER_ENABLED=
SCHEDULER_TICK_SECONDS=30

# -----------------------------------------------------------------------------
# Vision / OCR LLM (used by the vision_ocr tool).
# Same trust model as LLM_LARGE_*: the API key NEVER leaves smart-app-service.
# Builder pods and runtime engines call our internal proxy
# (/smart-app/internal/ocr) with a short-lived HMAC bearer instead of
# holding the raw key. ALL-OR-NOTHING, NO fallback to LLM_LARGE_*:
# set BOTH VISION_BASE_URL and VISION_API_KEY to enable OCR, or leave
# BOTH empty to disable it (apps that declare vision_ocr are then
# rejected at publish time with code=ocr_not_configured). Setting only
# one of the two is a boot-time error.
# e.g. VISION_BASE_URL=https://openrouter.ai/api/v1
# -----------------------------------------------------------------------------
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=z-ai/glm-4.6v:nitro
# HMAC signing key for the internal proxy bearer. REQUIRED — there is no
# fallback to JWT_SECRET. Keeping it dedicated isolates internal-route
# signing from end-user auth and avoids ambiguity over which key signs.
# If unset, internal bearer mint/verify fails fast with a clear error.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(64))"
SMART_APP_INTERNAL_SIGNING_KEY=
# How long minted internal bearers stay valid (seconds). Builder pods
# typically need ~30 minutes; runtime engines refresh on 401.
SMART_APP_INTERNAL_BEARER_TTL_SECONDS=3600

# -- Fraud image index (P2b) - near-dup/similar-image detection --
IMAGE_EMBED_URL=https://openrouter.ai/api/v1/embeddings
IMAGE_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# IMAGE_EMBED_API_KEY optional: only for a non-OpenRouter provider (self-hosted open-weights)
IMAGE_EMBED_STORE_DIM=2048
IMAGE_EMBED_INDEX_DIM=512

# Fraud locale pack: us | in (validators, phone rule, slash-date order)
FRAUD_LOCALE=us

# ── Added so a clean clone can actually start ──────────────────────────
# The service refuses to boot on fallback defaults (by design), so every
# variable it reads must appear here. Secrets are placeholders.
JWT_ALGORITHM=HS256
SMART_APP_SERVICE_CALLBACK_URL=http://host.docker.internal:9100
DATA_DISCOVERY_SERVICE_URL=http://localhost:8095
CITRA_MCP_URL=http://localhost:9090/mcp
RERANKER_SERVICE_URL=http://localhost:7302
FORCE_ACTION_TOOL_CALL=false
BUILDER_LLM_MODEL=deepseek/deepseek-v4-pro:nitro
LLM_LARGE_EXTRA_BODY={"reasoning":{"enabled":true,"effort":"medium","exclude":true}}
MCP_SERVICE_API_KEY=<set-me>
BUILD_SESSION_IDLE_TIMEOUT_SECONDS=1800
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:8081
EMBEDDING_API_KEY=<set-me>
EMBEDDING_MODEL=baai/bge-m3
LLM_API_KEY=<set-me>
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro:nitro
MILVUS_TOKEN=<set-me>
MILVUS_URI=http://localhost:29530
TEST_DISCOVERY_SERVICE_URL=http://localhost:9000
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_DIMENSION=768
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=<set-me>
REDIS_USERNAME=default
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=16380
QUEUE_REDIS_PASSWORD=<set-me>
REDIS_SSL=false
REDIS_CACHE_ENABLED=true
REDIS_CONNECTION_POOL_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
LLM_SMALL_MODEL=deepseek/deepseek-v4-flash:nitro
LLM_MEDIUM_MODEL=deepseek/deepseek-v4-flash:nitro
