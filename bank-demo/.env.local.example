# ── Public (reaches the browser — by design) ──────────────────────────────
# The embed key is NOT a secret: it lives in the host page's source, exactly
# like a Stripe publishable key. It names WHICH app and WHICH environment
# (emb_live_ = a real deployment, emb_test_ = the BA's test build).
# Authorisation is still the officer's own token.
#
# citra-app-runtime is what serves /api/embed/* (LOCAL_DOCKER_DEV.md port map).
NEXT_PUBLIC_CITRA_RUNTIME_URL=http://localhost:3100
NEXT_PUBLIC_CITRA_EMBED_KEY=emb_live_xxxxxxxxxxxxxxxx

# Optional — lights up the card on the Motor Claims screen once a claims
# decision app exists.
# NEXT_PUBLIC_CITRA_CLAIMS_EMBED_KEY=

# ── Server only (must NOT reach the browser) ──────────────────────────────
# Used by app/api/login/route.ts. No NEXT_PUBLIC_ prefix, so Next.js keeps it
# server-side: the officer's password and this URL never leave the bank's server.
USER_SERVICE_URL=http://localhost:7004
