# =============================================================================
# Citra AI — Web Frontend (Multi-stage: Expo build → Nginx)
# =============================================================================
# Build:  docker build -f Dockerfile.web -t citra-ui .
# Run:    docker run -e CITRA_API_URL=https://api.example.com -p 80:80 citra-ui
#
# The entrypoint injects runtime config from CITRA_* env vars into index.html.
# See docker-entrypoint.sh for all supported variables.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Build the Expo web app
# ---------------------------------------------------------------------------
FROM node:18-alpine AS build

WORKDIR /app

# Install dependencies first (layer cache friendly).
# .npmrc carries legacy-peer-deps=true and MUST come across with the manifests:
# react-joyride@2.9.3 peers on react "15 - 18" and this project is on react 19,
# so npm ci fails outright without it. Dockerfile.dev passes --legacy-peer-deps
# on the command line instead, which is why only the web image ever broke -- and
# nothing built this file until the release pipeline first ran.
COPY package.json package-lock.json* .npmrc* ./
RUN npm ci --prefer-offline

# Copy source and build
COPY . .

# Build as self-hosted by default — runtime config is injected by entrypoint
ARG EXPO_PUBLIC_ENVIRONMENT=self-hosted

ENV EXPO_PUBLIC_ENVIRONMENT=${EXPO_PUBLIC_ENVIRONMENT}

RUN npx expo export --platform web

# ---------------------------------------------------------------------------
# Stage 2: Serve with Nginx
# ---------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Copy built static files
COPY --from=build /app/dist /usr/share/nginx/html

# Runtime URL injection entrypoint
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# SPA fallback: serve index.html for all routes
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Gzip compression\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;\n\
    gzip_min_length 256;\n\
\n\
    # Cache static assets\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
\n\
    # SPA fallback\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    # Health check\n\
    location /healthz {\n\
        access_log off;\n\
        return 200 "ok";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
