              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Field"
        },
        "window_days": {
          "default": 90,
          "minimum": 1,
          "title": "Window Days",
          "type": "integer"
        }
      },
      "required": [
        "dataset",
        "match_field",
        "amount_field"
      ],
      "title": "ValueRealization",
      "type": "object"
    },
    "ValueSemantics": {
      "additionalProperties": false,
      "description": "The MONEY definition for a decision dataset — the canonical spine every\nROI number is computed from (docs/money-saved-roi-plan.md). Lives beside\n``decision_history`` (which defines OUTCOMES); this defines their VALUE.\n\nBecause it lives in sources.json, a pilot's metric definitions are frozen\nby a git commit at day zero, and every stamped value carries the hash of\nthe block that computed it (definition_version).",
      "properties": {
        "value_kind": {
          "$ref": "#/$defs/ValueKind"
        },
        "exposure_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure Field"
        },
        "realization": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueRealization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attribution": {
          "$ref": "#/$defs/ValueAttribution",
          "default": "approved_recommendation"
        },
        "prevented_when": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prevented When"
        }
      },
      "required": [
        "value_kind"
      ],
      "title": "ValueSemantics",
      "type": "object"
    },
    "VerifyAgainst": {
      "additionalProperties": false,
      "description": "Generic cross-dataset document verification (plan F4 — the E4 shape\nreused): a value extracted from a role-tagged document is looked up BY KEY\nin a declared target dataset, server-side. 'Reference not found' is a\nfact-grade signal; a full match is VERIFICATION. Examples: purchase bill →\nland registry, agent's \"cash collected\" → ledger, serial-in-photo → asset\nmaster, repair bill → surveyor estimate.",
      "properties": {
        "name": {
          "maxLength": 60,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "target_dataset": {
          "title": "Target Dataset",
          "type": "string"
        },
        "match_field": {
          "title": "Match Field",
          "type": "string"
        },
        "doc_column": {
          "title": "Doc Column",
          "type": "string"
        },
        "doc_ref_field": {
          "default": "reference",
          "title": "Doc Ref Field",
          "type": "string"
        },
        "compare": {
          "items": {
            "$ref": "#/$defs/VerifyCompare"
          },
          "title": "Compare",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name",
        "target_dataset",
        "match_field",
        "doc_column"
      ],
      "title": "VerifyAgainst",
      "type": "object"
    },
    "VerifyCompare": {
      "additionalProperties": false,
      "description": "One field-pair comparison within a verify_against block.",
      "properties": {
        "doc_field": {
          "title": "Doc Field",
          "type": "string"
        },
        "target_field": {
          "title": "Target Field",
          "type": "string"
        },
        "type": {
          "default": "text",
          "pattern": "^(amount|date|id|text)$",
          "title": "Type",
          "type": "string"
        },
        "tolerance_pct": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance Pct"
        },
        "window_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Days"
        }
      },
      "required": [
        "doc_field",
        "target_field"
      ],
      "title": "VerifyCompare",
      "type": "object"
    },
    "Visibility": {
      "additionalProperties": false,
      "description": "Who may READ this source. Enforced for structured reads (auth.py) and —\nas of the semantic-authz fix — for /semantic/search too.",
      "properties": {
        "roles_allowed": {
          "items": {
            "type": "string"
          },
          "title": "Roles Allowed",
          "type": "array"
        },
        "cross_org_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cross Org Ids",
          "type": "array"
        },
        "public_within_org": {
          "default": false,
          "title": "Public Within Org",
          "type": "boolean"
        }
      },
      "title": "Visibility",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/SourcesEnvelope"
    },
    {
      "items": {
        "$ref": "#/$defs/RegistrySource"
      },
      "type": "array"
