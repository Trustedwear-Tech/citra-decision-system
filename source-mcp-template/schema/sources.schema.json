{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citra-ai.com/schema/sources.schema.json",
  "title": "Citra dept-MCP sources.json",
  "description": "The source registry a dept-MCP loads (SOURCES_FILE / SOURCES_JSON). GENERATED from source-mcp-template/registry_models.py by gen_sources_schema.py — do not edit by hand; your change will be overwritten and CI will fail. Authoring guide: docs/sources-file.md. This schema covers structure/types/enums/unknown-keys; cross-field rules (mongodb->collection, semantic->rag, fraud->primary key) are enforced by validate_sources.py and at MCP boot.",
  "$defs": {
    "ArtifactRole": {
      "description": "What an artifact column IS, for fraud screening.",
      "enum": [
        "identity",
        "evidence",
        "supporting",
        "payment_proof"
      ],
      "title": "ArtifactRole",
      "type": "string"
    },
    "ColumnKind": {
      "description": "Whether a column's value is a media reference or plain data.",
      "enum": [
        "plain",
        "url",
        "image_url",
        "document_url",
        "file"
      ],
      "title": "ColumnKind",
      "type": "string"
    },
    "Connection": {
      "additionalProperties": true,
      "description": "How to reach the backend. Credentials NEVER inline — always `env_prefix`.\n\nextra=\"allow\" is deliberate (see module docstring): connection keys are\nbackend-specific and a wrong one fails loudly at connect time. The keys below\nare the ones the code reads or the real files author; others pass through.",
      "properties": {
        "env_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env Prefix"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "mongo_db": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mongo Db"
        },
        "collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collection"
        },
        "primary_key": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Key"
        },
        "tenant_filter": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Filter"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        }
      },
      "title": "Connection",
      "type": "object"
    },
    "DatasetKind": {
      "enum": [
        "sql",
        "mongodb",
        "rest",
        "odata",
        "soql",
        "duckdb",
        "bigquery",
        "sap_rfc",
        "semantic"
      ],
      "title": "DatasetKind",
      "type": "string"
    },
    "DateOrder": {
      "enum": [
        "DMY",
        "MDY",
        "YMD"
      ],
      "title": "DateOrder",
      "type": "string"
    },
    "DateRule": {
      "additionalProperties": false,
      "description": "E6 — one declarative date rule over the record's OWN columns. Fires\nwhen (later - earlier) < min_days_between (default 0 = plain ordering:\nan inspection dated before its work order) or > max_days_between when\nset (stale documents). Classic use: claim within days of policy start\n(min_days_between), statement older than N days (max_days_between).",
      "properties": {
        "name": {
          "maxLength": 60,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "earlier_field": {
          "title": "Earlier Field",
          "type": "string"
        },
        "later_field": {
          "title": "Later Field",
          "type": "string"
        },
        "min_days_between": {
          "default": 0,
          "title": "Min Days Between",
          "type": "integer"
        },
        "max_days_between": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Days Between"
        }
      },
      "required": [
        "name",
        "earlier_field",
        "later_field"
      ],
      "title": "DateRule",
      "type": "object"
    },
    "DecisionHistory": {
      "additionalProperties": false,
      "description": "Marks a dataset as the decision record that feeds the learning loop.",
      "properties": {
        "outcome_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Field"
        },
        "good_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Good Values"
        },
        "bad_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bad Values"
        },
        "neutral_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Neutral Values"
        },
        "outcome_hold_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome Hold Field"
        },
        "key_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Field"
        },
        "settling_window_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settling Window Days"
        },
        "decision_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Field"
        },
        "decided_at_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At Field"
        },
        "decided_by_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided By Field"
        },
        "rationale_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale Field"
        },
        "declared": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared"
        }
      },
      "title": "DecisionHistory",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "description": "The (vertical, sub_vertical, country) targeting triple — declared per\nSOURCE; a dataset may declare its own block to override.\n\nOnly ``vertical`` is required: if you declare a domain at all, say what\nindustry it is. ``country`` defaults to MULTINATIONAL and ``sub_vertical``\nmay be omitted when the industry has no meaningful sub-line.",
      "properties": {
        "vertical": {
          "title": "Vertical",
          "type": "string"
        },
        "sub_vertical": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sub Vertical"
        },
        "country": {
          "default": "MULTINATIONAL",
          "title": "Country",
          "type": "string"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "date_order": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateOrder"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "pack_advisory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pack Advisory"
        }
      },
      "required": [
        "vertical"
      ],
      "title": "Domain",
      "type": "object"
    },
    "FraudScreening": {
      "additionalProperties": false,
      "description": "Per-dataset fraud opt-in.",
      "properties": {
        "applies": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applies"
        },
        "value_fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Fields"
        },
        "identity_fields": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Fields"
        },
        "incident_date_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incident Date Field"
        },
        "location_lat_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Lat Field"
        },
        "location_lon_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Lon Field"
        },
        "gps_radius_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gps Radius Km"
        },
        "payment_proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/PaymentProof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verify_against": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/VerifyAgainst"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verify Against"
        },
        "date_rules": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/DateRule"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Rules"
        }
      },
      "title": "FraudScreening",
      "type": "object"
    },
    "Options": {
      "additionalProperties": false,
      "properties": {
        "tables": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tables"
        },
        "invocation_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Template"
        },
        "query_timeout_seconds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Timeout Seconds"
        }
      },
      "title": "Options",
      "type": "object"
    },
    "Organization": {
      "additionalProperties": false,
      "description": "The customer's DISPLAY identity (docs/runtime-ui-modernization-plan.md\nTrack E) — declared once, per source, by IT at connection time; every app\nbuilt on the source inherits it (app headers, browser titles, agent\nprompts, the Money-impact card). This is presentation identity ONLY —\nauth/tenancy (`org_id`) is untouched. When a tenant's sources declare\nconflicting blocks, consumption is first-wins (deterministic + visible).",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "short_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Name"
        },
        "logo_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Url"
        },
        "brand_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand Color"
        }
      },
      "required": [
        "name"
      ],
      "title": "Organization",
      "type": "object"
    },
    "PaymentProof": {
      "additionalProperties": false,
      "description": "E4 payment-proof verification config (see FraudScreening.payment_proof).",
      "properties": {
        "ledger_dataset": {
          "title": "Ledger Dataset",
          "type": "string"
        },
        "match_field": {
          "title": "Match Field",
          "type": "string"
        },
        "amount_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Field"
        },
        "date_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Field"
        },
        "party_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Party Field"
        },
        "doc_ref_field": {
          "default": "transaction_ref",
          "title": "Doc Ref Field",
          "type": "string"
        },
        "doc_amount_field": {
          "default": "amount",
          "title": "Doc Amount Field",
          "type": "string"
        },
        "doc_date_field": {
          "default": "payment_date",
          "title": "Doc Date Field",
          "type": "string"
        },
        "doc_party_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Party Field"
        },
        "amount_tolerance_pct": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Tolerance Pct"
        },
        "date_window_days": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Window Days"
        }
      },
      "required": [
        "ledger_dataset",
        "match_field"
      ],
      "title": "PaymentProof",
      "type": "object"
    },
    "Rag": {
      "additionalProperties": false,
      "description": "Semantic (RAG) wiring. The MCP never queries these — the platform reader\ndoes; the MCP only advertises the collection to discovery.",
      "properties": {
        "milvus_collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Milvus Collection"
        },
        "s3_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "S3 Prefix"
        }
      },
      "title": "Rag",
      "type": "object"
    },
    "ReadVia": {
      "additionalProperties": true,
      "description": "How to read this dataset. `extra` carries kind-specific wiring — notably\nthe REST request/response mapping (catalogue.py) and duckdb file lists.",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "files": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Files"
        },
        "extra": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra"
        }
      },
      "title": "ReadVia",
      "type": "object"
    },
    "RegistryColumn": {
      "additionalProperties": false,
      "description": "One authored column. The ontology lives here.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "physical_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Name"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "nullable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nullable"
        },
        "is_primary_key": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Primary Key"
        },
        "is_foreign_key": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Foreign Key"
        },
        "foreign_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Foreign Ref"
        },
        "pii": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pii"
        },
        "sensitivity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sensitivity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "semantic_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Type"
        },
        "distinct_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct Values"
        },
        "range": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        },
        "column_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mime_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mime Hint"
        },
        "artifact_role": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reuse_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReusePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
