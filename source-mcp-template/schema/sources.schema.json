    "ValueAttribution": {
      "description": "THE attribution rule — pre-agreed at day zero, versioned in git. Which\ndecisions' value counts as Citra's. Changing it mid-pilot is a VISIBLE\nontology change (new definition_version), never a silent re-cut.",
      "enum": [
        "approved_recommendation",
        "any_citra_touched",
        "approved_within_window"
      ],
      "title": "ValueAttribution",
      "type": "string"
    },
    "ValueKind": {
      "description": "What one unit of realized value IS (docs/money-saved-roi-plan.md §2).",
      "enum": [
        "recovered",
        "prevented_loss",
        "sanctioned",
        "settled"
      ],
      "title": "ValueKind",
      "type": "string"
    },
    "ValueRealization": {
      "additionalProperties": false,
      "description": "WHERE value is realized — usually a different dataset (the payments\nledger). Cross-dataset by design, same as payment_proof: the dataset and\ncolumns are validated against the catalogue when consumed.",
      "properties": {
        "dataset": {
          "title": "Dataset",
          "type": "string"
        },
        "match_field": {
          "title": "Match Field",
          "type": "string"
        },
