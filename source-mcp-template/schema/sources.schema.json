    "SourceType": {
      "description": "How the MCP reaches this backend.\n\n`bigquery`, `sap_rfc` and `duckdb` are NOT speculative: catalogue._source_kind\nbranches on them and 3 of the 19 live sources use them. models.SourceType\nlists only the first four, and docs/sources-file.md said the same — so\nvalidating against that enum would have rejected working sources. The doc is\nfixed; this is the real set.",
      "enum": [
        "semantic",
        "structured",
        "mongodb",
        "rest_api",
        "bigquery",
        "sap_rfc",
        "duckdb"
