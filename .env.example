# =============================================================================
# Citra Decision System — the one configuration file
# =============================================================================
#   cp .env.example .env      # then set LLM_API_KEY below
#   make install              # data stores -> services -> acme-bank demo
#
# There is ONE .env for the whole stack. Every service is fed this file by
# docker-compose.quickstart.yml (`env_file: [.env]`) — services do NOT read
# per-directory .env files, so this is the only place configuration lives.
#
# Every value below is a SAFE LOCAL DEFAULT wired to the containers the
# quickstart starts. The ONLY thing you must set is LLM_API_KEY.
#
# Deploying for real? Each section carries commented alternatives for a
# production / self-hosted deployment (own domain, own GPU endpoint). Change
# every password and secret before this stack is reachable on a network.
# =============================================================================

ENVIRONMENT=dev
LOG_LEVEL=INFO
# Production: ENVIRONMENT=prod

# ── Home org + super-admin (seeded by the quickstart) ───────────────────────
ORG_ID=citra-ai
ORG_NAME=Citra AI
ADMIN_EMAIL=admin@citra-ai.com
ADMIN_PASSWORD=ChangeMe!123
# Legacy gate still consulted by some admin routes — keep in step with
# ADMIN_EMAIL, or those routes will refuse the account you just created.
ADMIN_EMAILS=admin@citra-ai.com

# ── Shared auth secret (HS256). Same value signs and verifies. ──────────────
# Production: openssl rand -hex 48
JWT_SECRET=citra-local-dev-jwt-secret-change-me-0000000000000000000000000000

# Internal HMAC bearer between the SmartApp builder/runtime and
# smart-app-service (mints/verifies /smart-app/internal/* calls). Any stable
# secret. Empty value -> builds + internal routes fail.
SMART_APP_INTERNAL_SIGNING_KEY=citra-local-dev-smartapp-signing-change-me-00000000
# Fernet-derived key for encrypting Workflow connection credentials.
CONNECTION_ENCRYPTION_KEY=citra-local-dev-connection-encryption-change-me-00000000

# ── UI login ────────────────────────────────────────────────────────────────
# Email/password by default, so a working login screen needs no Google Cloud
# project. Set to `google` or `google,local` to add Google sign-in.
AUTH_PROVIDERS=local
# Passwordless "enter email -> token" login. LOCAL ONLY — fail-closed in prod.
ALLOW_DEV_LOGIN=true
# Production: ALLOW_DEV_LOGIN=false
# Leave empty so the UI hides the Google button locally.
GOOGLE_CLIENT_ID_WEB=

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Different services read different variable names; all point at the same DB.
# A single-node replica set is required (retryable writes + change streams).
MONGODB_CONN_STRING=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_CONNECTION_STRING=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_URI=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGO_URI=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=citra
MONGO_DB=citra
# REQUIRED — docker compose refuses to start without it (it is the Mongo root
# password the container is created with, so it must match the URIs above).
MONGODB_PASSWORD=citradev
# Remote Mongo: replace the host in every URI above, e.g.
#   mongodb://root:PASSWORD@10.0.1.10:27017/?authSource=admin&replicaSet=rs0

# ── Redis: cache + durable job queue (two separate instances) ───────────────
REDIS_HOST=citra-redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false
QUEUE_REDIS_HOST=queue-redis
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_USERNAME=
QUEUE_REDIS_PASSWORD=

# ── Milvus vector database ──────────────────────────────────────────────────
MILVUS_URI=http://citra-milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=citra
MILVUS_SAAS_COLLECTION=saas
# Remote: MILVUS_URI=http://10.0.1.11:19530

# ── Object storage — S3-compatible (local MinIO) ────────────────────────────
# Port 9000, not 9002: services reach MinIO over the docker network, so this
# is its CONTAINER port. 9002 is only the host-side publish of it
# (docker-compose.infra.yml maps "9002:9000"), and nothing listens on 9002
# inside the network -- pointing this at 9002 makes every object write fail
# with connection refused.
BUCKET_ENDPOINT_URL=http://citra-minio:9000
BUCKET_NAME=citra-documents
# REQUIRED — docker compose refuses to start without these two.
BUCKET_ACCESS_KEY=minioadmin
BUCKET_SECRET_KEY=minioadmin
BUCKET_REGION=us-east-1
# Milvus's own internal MinIO — kept separate from the application bucket.
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin

# ── Postgres — backs the bundled acme-bank demo's system-of-record only ─────
# Not required by the platform itself.
POSTGRES_USER=citra
POSTGRES_PASSWORD=citra-local-dev

# ── Dept-MCP shared key + discovery ─────────────────────────────────────────
# REQUIRED — docker compose refuses to start without MCP_API_KEY.
MCP_API_KEY=demo-mcp-key-local-only
# smart-app-service authenticates to the MCP with this — it MUST equal
# MCP_API_KEY above. When they drift, the catalogue crawler sends the caller's
# user token as the service guard, the MCP answers 401, and the data catalogue
# stays SILENTLY empty.
MCP_SERVICE_API_KEY=demo-mcp-key-local-only
# In-network URL — unaffected by which host port discovery-service publishes.
DISCOVERY_URL=http://discovery-service:9000

# =============================================================================
# AI providers — YOU MUST SET LLM_API_KEY
# =============================================================================
# The platform calls an LLM for every recommendation and every NL->SQL query.
# Nothing decision-related works until a key is set here. The stack still
# starts without one; Decision Apps then error when you run them.
#
# ONE OpenRouter key powers LLM, embeddings, search and vision. Get one at
# https://openrouter.ai/keys — or point the URLs at OpenAI, DeepSeek, or a
# self-hosted vLLM endpoint.
LLM_BASE_URL=https://openrouter.ai/api/v1
# REQUIRED: paste the key after the = — no quotes, and no trailing comment
# (env_file keeps everything after '=' as the value).
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat-v3.1
# Self-hosted GPU instead:
#   LLM_BASE_URL=http://inference-service:8000/v1
#   LLM_API_KEY=
#   LLM_MODEL=zai-org/GLM-5.1

# Embeddings — an open-weights model, served by the same OpenRouter key.
# EMBEDDING_DIMENSION must match the dim the Milvus collection was ingested
# at; the platform standardises on 768 and the client sends `dimensions` on
# every call, so the model returns 768 rather than its native 1024.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSION=768
# Self-hosting the same model: point EMBEDDING_BASE_URL at your own vLLM and
# either keep 768, or set EMBEDDING_DIMENSION=0 to get bge-m3's native 1024
# (then MILVUS_VECTOR_DIM must be 1024 to match).
#
# CHANGING THE MODEL MEANS RE-INGESTING, even at the same dimension. Vectors
# written by a different model do not share an embedding space with the new
# model's query vectors, so old rows silently stop matching. Re-run the seed
# (or your own ingestion) after any change here.

# Internet search (optional — the chat's "search the internet" path).
# perplexity = chat-completions, which OpenRouter serves. The 'grok' default
# uses the xAI Responses API, which OpenRouter does not.
SEARCH_PROVIDER=perplexity
SEARCH_BASE_URL=https://openrouter.ai/api/v1
SEARCH_API_KEY=
SEARCH_MODEL=perplexity/sonar

# Vision (image understanding for OCR / critique / printable).
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_API_KEY=
VISION_MODEL=qwen/qwen3-vl-32b-instruct

# Web reader / scraping (optional). Serper.dev key — blank disables it.
SERPER_API_KEY=

# Image generation and audio transcription are NOT LLMs and are NOT served by
# OpenRouter. Optional, off by default; configure only if you need them:
#   IMAGE_GEN_BASE_URL=  IMAGE_GEN_API_KEY=  IMAGE_GEN_MODEL=
#   AUDIO_TO_TEXT_BASE_URL=  AUDIO_TO_TEXT_API_KEY=  AUDIO_TO_TEXT_MODEL=

# ── URLs / CORS ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8081
WEBSITE_URL=http://localhost:8081
APP_URL=http://localhost:8081
BASE_URL=http://localhost:8085
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080
CITRA_UI_ORIGIN=http://localhost:8081
FORCE_HTTPS=false
# Production — point all of the above at your own domain and turn on HTTPS:
#   FRONTEND_URL=https://citra.yourdomain.com   (and WEBSITE_URL, APP_URL,
#   BASE_URL, CORS_ALLOWED_ORIGINS, CITRA_UI_ORIGIN to match)
#   FORCE_HTTPS=true

# ── Feature flags (pinned to the product-correct values) ────────────────────
# Some in-code defaults differ from how the product is actually run; these are
# pinned so a fresh install behaves the same way.
ENABLE_MONGODB_CHAT_HISTORY=true
# Do NOT let the LLM rename columns during a catalogue crawl — it silently
# breaks every downstream query that referenced the original name.
LLM_ENRICHMENT_ENABLED=false

# ── Misc ────────────────────────────────────────────────────────────────────
ALERT_TRANSPORT=log
AUTHZ_ENFORCE=true

# ── Internal service-to-service ─────────────────────────────────────────────
ADMIN_API_KEY=citra-local-admin-key-change-me
SMART_APP_SERVICE_CALLBACK_URL=http://smart-app-service:9100
CITRA_SERVICE_URL=http://citra-service:8085
CITRA_MCP_URL=http://citra-mcp-service:9090

# =============================================================================
# Optional — only needed for specific deployments
# =============================================================================
# Self-hosted GPU inference (vLLM), when LLM_BASE_URL points at your own box:
#   INFERENCE_PORT=8000
#   INFERENCE_TENSOR_PARALLEL=2
#   INFERENCE_MAX_MODEL_LEN=32768
#   INFERENCE_GPU_MEMORY_UTILIZATION=0.90
#   HF_HOME=/models
#
# Email alerting (ALERT_TRANSPORT=smtp):
#   SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=
#   MONITOR_EMAIL_FROM=  MONITOR_EMAIL_TO=
#
# Vault, instead of secrets in this file (recommended for production):
#   VAULT_ADDR=http://vault:8200
#   VAULT_SECRET_PATH=prod/citra-ai
#   VAULT_ROLE_ID=  VAULT_SECRET_ID=
#
# TLS termination via Traefik:
#   DOMAIN=citra.yourdomain.com
#   ACME_EMAIL=admin@yourdomain.com
