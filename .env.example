# Citra Decision System — copied to .env by `make wizard`.
#
# TWO ZONES, and the split is load-bearing:
#
#   Above the FINE-TUNING marker — settings with no usable default in code.
#   These must be set for the stack to work, and the wizard writes here.
#
#   Below it — knobs that DO have a default in code (getenv(KEY, fallback)).
#   They are listed so you can see and change them, not because they are
#   required. Delete a line and the code default applies. The wizard does
#   NOT touch anything below the marker, so hand-tuned values survive a
#   re-run.

# ============================ REQUIRED ===============================

ADMIN_API_KEY=citra-local-admin-key-change-me
ADMIN_EMAIL=admin@citra-ai.com
ADMIN_PASSWORD=ChangeMe!123
ALERT_TRANSPORT=log
APP_URL=http://localhost:8081
AUDIO_TO_TEXT_API_KEY=
AUDIO_TO_TEXT_BASE_URL=https://api.simplismart.live/predict
AUDIO_TO_TEXT_MODEL=openai/whisper-large-v3-turbo
AUDIO_TO_TEXT_PROVIDER=simplismart
AUTHZ_ENFORCE=true
AUTH_PROVIDERS=local
BASE_URL=http://localhost:8085
BUCKET_ACCESS_KEY=minioadmin
BUCKET_ENDPOINT_URL=http://citra-minio:9000
BUCKET_NAME=citra-documents
BUCKET_REGION=us-east-1
BUCKET_SECRET_KEY=minioadmin
CITRA_MCP_URL=http://citra-mcp-service:9090
CITRA_SERVICE_URL=http://citra-service:8085
CONNECTION_ENCRYPTION_KEY=citra-local-dev-connection-encryption-change-me-00000000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080
DATA_DISCOVERY_SERVICE_URL=http://localhost:8095
DISCOVERY_URL=http://discovery-service:9000
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL=baai/bge-m3
ENABLE_MONGODB_CHAT_HISTORY=true
ENVIRONMENT=dev
FORCE_HTTPS=false
IMAGE_GEN_PROVIDER=runware
JWT_SECRET=citra-local-dev-jwt-secret-change-me-0000000000000000000000000000
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_ENRICHMENT_ENABLED=false
LLM_LARGE_API_KEY=
LLM_LARGE_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro:nitro
LOG_LEVEL=INFO
MCP_API_KEY=demo-mcp-key-local-only
MCP_SERVICE_API_KEY=demo-mcp-key-local-only
MILVUS_COLLECTION=citra
MILVUS_MINIO_ACCESS_KEY=minioadmin
MILVUS_MINIO_SECRET_KEY=minioadmin
MILVUS_SAAS_COLLECTION=saas
MILVUS_TOKEN=
MILVUS_URI=http://citra-milvus:19530
MONGODB_CONNECTION_STRING=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_CONN_STRING=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=citra
MONGODB_PASSWORD=citradev
MONGODB_URI=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGO_CITRA_CONN=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGO_DB=citra
MONGO_URI=mongodb://root:citradev@mongodb:27017/?authSource=admin&replicaSet=rs0
# The deployment home org. Every user who signs in through the UI belongs to it.
ORG_ID=citra-ai
# Home department for users who arrive without one. LEAVE UNSET unless your
# deployment really has a single home department: when it is unset no
# department is assigned, which is a state the platform handles. Assigning a
# department the deployment never created is not -- that is what this used to
# do, hardcoded, and it filed every self-hosted install's users into a
# department belonging to another org.
DEFAULT_DEPT_ID=
POSTGRES_PASSWORD=citra-local-dev
POSTGRES_USER=citra
QUEUE_REDIS_HOST=queue-redis
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_USERNAME=
REDIS_HOST=citra-redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_SSL=false
REDIS_USERNAME=
SANDBOX_HOST_BUILDER_IMAGE=citra-app-builder:latest
# SANDBOX_HOST_IMAGE — image for the generic (non-builder) sandbox profile.
# Intentionally UNSET: the only consumer that used it (action-chat-service)
# was removed from this repo. Set it to your own overlay built on
# citra-agent-sandbox-base if you add one; a non-builder spawn while it is
# blank fails immediately with an explicit message.
SANDBOX_HOST_IMAGE=
SANDBOX_HOST_URL=http://localhost:7090
SEARCH_API_KEY=
SEARCH_BASE_URL=https://openrouter.ai/api/v1
SEARCH_MODEL=perplexity/sonar
SEARCH_PROVIDER=perplexity
SERPER_API_KEY=
SMART_APP_INTERNAL_SIGNING_KEY=citra-local-dev-smartapp-signing-change-me-00000000
# Read by citra-mcp-service: smart-app-service's internal API root, used by
# citra_visual_review for its vision-critique step. citra-mcp-service does NOT
# hold the signing key — it relays the internal bearer the builder pod sends as
# X-Smart-App-Internal. Must match SMART_APP_SERVICE_CALLBACK_URL below.
SMART_APP_INTERNAL_URL=http://smart-app-service:9100/smart-app/internal
SMART_APP_SERVICE_CALLBACK_URL=http://smart-app-service:9100
VISION_API_KEY=
VISION_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=qwen/qwen3-vl-32b-instruct
RERANK_API_KEY=
LLM_MEDIUM_API_KEY=
LLM_SMALL_API_KEY=
CITRA_DOCKER_NETWORK=citra-network
ACME_BANK_PG_PORT=15444
CITRA_API_URL=http://localhost:8085
CITRA_AUTH_BASE_URL=http://localhost:7004/api/auth
CITRA_USER_SERVICE_URL=http://localhost:7004

# ============================ FINE-TUNING ============================
