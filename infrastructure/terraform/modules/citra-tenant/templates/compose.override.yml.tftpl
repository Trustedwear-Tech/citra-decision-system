# GENERATED BY TERRAFORM — do not edit by hand.
# Per-service replica counts for this tenant. Applied on top of the base stack:
#   docker compose -f compose.yml -f compose.override.yml up -d
# (Compose v2 honours deploy.replicas; Traefik/docker-DNS load-balances across them.)
services:
%{ for name, cfg in services ~}
  ${name}:
    deploy:
      replicas: ${cfg.replicas}
%{ endfor ~}
