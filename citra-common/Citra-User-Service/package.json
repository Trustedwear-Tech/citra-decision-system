{
  "name": "user-service-express",
  "version": "2.0.0",
  "description": "User Service converted from Azure Functions to Express.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:dev": "nodemon server.js",
    "start:local": "NODE_ENV=development node server.js",
    "start:production": "NODE_ENV=production node server.js",
    "start:vault": "node server.js",
    "test": "echo \"No tests yet...\"",
    "test:subscription-schedule": "node src/tests/run_subscription_schedule_test.js",
    "test:env": "node -e \"require('./src/config/vault-env-loader').loadVaultSecrets().then(() => console.log('Environment variables loaded successfully'))\"",
    "convert": "node convert-functions.js"
  },
  "keywords": [
    "express",
    "nodejs",
    "api",
    "user-service",
    "citraai"
  ],
  "dependencies": {
    "@aws-sdk/client-ses": "^3.713.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@sentry/node": "^10.0.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^12.0.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.1.0",
    "googleapis": "^171.4.0",
    "joi": "^17.13.3",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.2",
    "@mongodb-js/zstd": "^2.0.1",
    "mongoose": "^8.16.3",
    "node-fetch": "^2.6.1",
    "nodemailer": "^10.0.0",
    "redis": "^5.5.6"
  },
  "//overrides": [
    "express 4 pins qs through body-parser, so qs never moves when express is",
    "patched -- it sat at 6.14.2 against three advisories fixed in 6.16.0.",
    "body-parser was only ever flagged for depending on it; this clears both."
  ],
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  }
}
