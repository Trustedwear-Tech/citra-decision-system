# Server Configuration
PORT=7004
NODE_ENV=development

# ── Auth Providers ──
# Comma-separated allowlist: 'google', 'local', 'oidc' (any combination).
#   demo/Citra:  google,local
#   customer:    oidc,local   (OIDC for the workforce; keep `local` for the
#                              break-glass super_admin from scripts/bootstrap_admin.js)
AUTH_PROVIDERS=google,local

# ── OIDC (per-customer enterprise SSO — only when AUTH_PROVIDERS includes 'oidc') ──
# ONE IdP per single-tenant deployment (Okta / Azure AD / Auth0 / Keycloak / …).
# The SPA runs the OIDC (PKCE) flow and POSTs the ID token to /api/auth/oidc;
# we verify it against the issuer's JWKS and require aud == OIDC_CLIENT_ID.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Optional — else discovered from ${OIDC_ISSUER}/.well-known/openid-configuration
OIDC_JWKS_URI=
# Optional — path to the group→dept map (default ./config/oidc-group-map.json).
# When that file EXISTS, the customer's directory groups drive dept_ids/roles on
# every login, so officers arrive already entitled instead of needing a manual
# grant each; without it, first-time SSO users land with zero access. Copy
# config/oidc-group-map.example.json to start. A path set here that does not
# resolve is a hard startup failure, never a silent fallback.
OIDC_GROUP_MAP_PATH=

# ── Email Provider (required for local auth) ──
# Must be 'ses' or 'smtp' — no fallback, explicit config only
EMAIL_PROVIDER=smtp
EMAIL_DEFAULT_SENDER=noreply@your-domain.com
EMAIL_DEFAULT_TO=admin@your-domain.com

# Option A — AWS SES (when EMAIL_PROVIDER=ses):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Option B — SMTP (when EMAIL_PROVIDER=smtp):
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# App URL (used in verification/reset emails)
APP_URL=http://localhost:8081

# Google OAuth — register your own app: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID_WEB=

# MongoDB
# Self-hosted: mongodb://root:password@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_CONNECTION_STRING=mongodb://root:password@mongodb:27017/?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=citra

# JWT (must match Citra-Service JWT_SECRET)
JWT_SECRET=change-me-generate-a-64-byte-hex-secret
JWT_EXPIRES_IN=7d

# Admin emails (comma-separated)
ADMIN_EMAILS=admin@your-domain.com

# ── Single-tenant org identity ──
# Each on-prem / private-cloud deployment is bound to exactly one org.
# Every new user gets org_id=ORG_ID at signup; super_admin assigns depts/roles.
ORG_ID=citra-ai
ORG_NAME=Citra AI

# Depts seed file (upserted into `depts` collection on service startup)
DEPTS_SEED_PATH=./config/depts.seed.json

# Cross-service
CITRA_SERVICE_URL=http://localhost:8085
CORS_ALLOWED_ORIGINS=http://localhost:8081
