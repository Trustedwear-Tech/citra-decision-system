const CitraAIUser = require('../models/CitraAIUser');
const CreditTransaction = require('../models/CreditTransaction');
const usageTrackingService = require('../services/usageTrackingService');
const axios = require('axios');
const sendEmail = require('../shared/sendEmail');
const { google } = require('googleapis');

/**
 * Verify Google Play purchase receipt server-side
 * Uses Google Play Developer API v3 (androidpublisher)
 * 
 * Requires env vars:
 *   GOOGLE_PLAY_PACKAGE_NAME   — e.g., "com.citraai.app"
 *   GOOGLE_SERVICE_ACCOUNT_KEY — JSON key for service account with Play Console access
 * 
 * @param {string} purchaseToken - Purchase token from client
 * @param {string} productId - Product ID (SKU) purchased
 * @returns {{ valid: boolean, orderId: string|null, reason: string }}
 */
async function verifyGoogleReceipt(purchaseToken, productId) {
  try {
    const packageName = process.env.GOOGLE_PLAY_PACKAGE_NAME;
    const serviceAccountKey = process.env.GOOGLE_SERVICE_ACCOUNT_KEY;

    if (!packageName || !serviceAccountKey) {
      console.warn('⚠️ [MOBILE] Google Play verification not configured — GOOGLE_PLAY_PACKAGE_NAME or GOOGLE_SERVICE_ACCOUNT_KEY missing');
      return { valid: false, orderId: null, reason: 'Google Play verification not configured on server' };
    }

    let credentials;
    try {
      credentials = JSON.parse(serviceAccountKey);
    } catch {
      console.error('❌ [MOBILE] Invalid GOOGLE_SERVICE_ACCOUNT_KEY JSON');
      return { valid: false, orderId: null, reason: 'Invalid service account credentials' };
    }

    const auth = new google.auth.GoogleAuth({
      credentials,
      scopes: ['https://www.googleapis.com/auth/androidpublisher']
    });

    const androidPublisher = google.androidpublisher({ version: 'v3', auth });

    const response = await androidPublisher.purchases.products.get({
      packageName,
      productId,
      token: purchaseToken
    });

    const purchase = response.data;
    // purchaseState: 0 = Purchased, 1 = Canceled, 2 = Pending
    if (purchase.purchaseState === 0) {
      return { valid: true, orderId: purchase.orderId, reason: 'Purchase verified' };
    } else {
      return { valid: false, orderId: purchase.orderId, reason: `Purchase state: ${purchase.purchaseState}` };
    }
  } catch (err) {
    console.error('❌ [MOBILE] Google Play verification error:', err.message);
    return { valid: false, orderId: null, reason: `Verification error: ${err.message}` };
  }
}

/**
 * Verify Apple App Store receipt server-side
 * Uses Apple's verifyReceipt endpoint (legacy) or App Store Server API
 * 
 * Requires env vars:
 *   APPLE_SHARED_SECRET — App-specific shared secret from App Store Connect
 *   APPLE_VERIFY_ENV    — 'production' or 'sandbox' (defaults to 'production')
 * 
 * @param {string} receiptData - Base64-encoded receipt from client
 * @returns {{ valid: boolean, orderId: string|null, reason: string }}
 */
async function verifyAppleReceipt(receiptData) {
  try {
    const sharedSecret = process.env.APPLE_SHARED_SECRET;

    if (!sharedSecret) {
      console.warn('⚠️ [MOBILE] Apple receipt verification not configured — APPLE_SHARED_SECRET missing');
      return { valid: false, orderId: null, reason: 'Apple verification not configured on server' };
    }

    const env = process.env.APPLE_VERIFY_ENV || 'production';
    const verifyUrl = env === 'sandbox'
      ? 'https://sandbox.itunes.apple.com/verifyReceipt'
      : 'https://buy.itunes.apple.com/verifyReceipt';

    const response = await axios.post(verifyUrl, {
      'receipt-data': receiptData,
      password: sharedSecret,
      'exclude-old-transactions': true
    });

    const result = response.data;

    // Status 0 = valid receipt
    // Status 21007 = sandbox receipt sent to production → retry in sandbox
    if (result.status === 21007 && env === 'production') {
      console.log('ℹ️ [MOBILE] Sandbox receipt detected — retrying with sandbox URL');
      const sandboxResp = await axios.post('https://sandbox.itunes.apple.com/verifyReceipt', {
        'receipt-data': receiptData,
        password: sharedSecret,
        'exclude-old-transactions': true
      });
      const sandboxResult = sandboxResp.data;
      if (sandboxResult.status === 0) {
        const latestTxn = sandboxResult.latest_receipt_info?.[0];
        return { valid: true, orderId: latestTxn?.transaction_id || null, reason: 'Sandbox receipt verified' };
      }
      return { valid: false, orderId: null, reason: `Apple sandbox status: ${sandboxResult.status}` };
    }

    if (result.status === 0) {
      const latestTxn = result.latest_receipt_info?.[0];
      return { valid: true, orderId: latestTxn?.transaction_id || null, reason: 'Receipt verified' };
    }

    return { valid: false, orderId: null, reason: `Apple status: ${result.status}` };
  } catch (err) {
    console.error('❌ [MOBILE] Apple receipt verification error:', err.message);
    return { valid: false, orderId: null, reason: `Verification error: ${err.message}` };
  }
}

/**
 * Verify Mobile Purchase (Google Play / App Store)
 * Verifies receipt server-side and grants credits with idempotency
 */
const handler = async (req, res) => {
    try {
        const {
            pack_id,
            receipt, // purchaseToken (Android) or transactionReceipt (iOS)
            product_id,
            amount,
            currency = 'INR',
            orderId, // Transaction ID from store
            platform // 'android' or 'ios' (derived from route or body)
        } = req.body;

        // SECURITY: Use authenticated email from JWT token, never from request body
        const email = req.user.email;

        // Detect platform if not provided (based on route usually, but here we might handle both)
        const isIos = req.originalUrl.includes('apple');
        const platformName = isIos ? 'iOS' : 'Android';

        if (!email || !pack_id || !receipt || !amount) {
            return res.status(400).json({
                error: 'Missing required fields: pack_id, receipt, amount'
            });
        }

        // Verify user
        const user = await CitraAIUser.findOne({ email });
        if (!user) {
            return res.status(404).json({ error: 'User not found' });
        }

        console.log(`📱 [${platformName}] Verifying purchase for ${email}:`, { pack_id, amount, orderId });

        // ── Server-Side Receipt Verification ──
        let verificationResult;
        let transactionParams = {};

        if (isIos) {
            verificationResult = await verifyAppleReceipt(receipt);
            transactionParams = {
                source: 'app_store',
                transaction_id: verificationResult.orderId || orderId || `ios_${Date.now()}`
            };
        } else {
            verificationResult = await verifyGoogleReceipt(receipt, product_id);
            transactionParams = {
                source: 'google_play',
                transaction_id: verificationResult.orderId || orderId || `android_${Date.now()}`
            };
        }

        if (!verificationResult.valid) {
            console.error(`🚨 [${platformName}] Receipt verification FAILED for ${email}: ${verificationResult.reason}`);
            return res.status(400).json({
                error: 'Purchase verification failed',
                reason: verificationResult.reason,
                platform: platformName
            });
        }

        console.log(`✅ [${platformName}] Receipt verified: ${verificationResult.reason}`);

        // ── Idempotency Check — prevent double-crediting ──
        const storeTransactionId = transactionParams.transaction_id;
        const existingTransaction = await CreditTransaction.findOne({
            razorpay_payment_id: storeTransactionId // Re-using this field for mobile transaction IDs
        });

        if (existingTransaction) {
            console.warn(`⚠️ [${platformName}] Duplicate transaction: ${storeTransactionId} already processed`);
            return res.status(409).json({
                error: 'Purchase already processed',
                transaction_id: existingTransaction.transaction_id,
                message: 'This purchase was already applied to your account.'
            });
        }

        // Get IP and User Agent
        const ipAddress = req.headers['x-forwarded-for'] || req.ip || 'unknown';
        const userAgent = req.headers['user-agent'] || 'unknown';

        // Calculate credits — map product_id to server-side pricing rather than trusting client amount
        // Mobile pack amounts should correspond to known products configured in the app stores
        let creditsToAdd = amount; // Fallback to client amount if no mapping found
        let exchangeRate = null;

        // TODO: When store products are formalised, map product_id → server-side price table
        // For now, as a safety measure, cap the credit amount to reasonable bounds
        const MAX_SINGLE_PURCHASE_INR = 50000;
        if (currency === 'INR' && creditsToAdd > MAX_SINGLE_PURCHASE_INR) {
          console.error(`🚨 [${platformName}] Suspicious amount: ₹${creditsToAdd} exceeds max ₹${MAX_SINGLE_PURCHASE_INR}`);
          return res.status(400).json({ error: 'Purchase amount exceeds maximum allowed' });
        }

        if (currency !== 'INR') {
          if (currency === 'USD') {
            try {
              const response = await axios.get('https://api.exchangerate-api.com/v4/latest/USD');
              const rate = response.data?.rates?.INR;
              if (rate && rate > 50 && rate < 200) {
                exchangeRate = rate;
                creditsToAdd = amount * rate;
              } else {
                throw new Error(rate ? `Rate out of bounds: ${rate}` : 'Rate not found');
              }
            } catch {
              exchangeRate = 85;
              creditsToAdd = amount * 85;
            }
          }
        }

        // Store in DB (use verified store transaction ID for idempotency tracking)
        const source = platform === 'google' ? 'google_play' : 'app_store';
        const result = await usageTrackingService.addCredits(
            user.email,
            user.email,
            creditsToAdd,
            storeTransactionId,             // Payment ID (store transaction ID)
            orderId || `mobile_order_${Date.now()}`, // Order ID
            `${platformName.toLowerCase()}_verified`, // Signature (server-verified)
            ipAddress,
            userAgent,
            { source, currency: currency || 'INR', original_amount: amount, exchange_rate: exchangeRate }
        );

        console.log(`✅ [${platformName}] Credits added:`, result);

        // Send Receipt Email
        sendReceiptEmail({
            email: user.email,
            name: user.name || 'Valued Customer',
            amount,
            currency,
            creditsAdded: result.total_credits_added,
            transactionId: transactionParams.transaction_id,
            date: new Date().toLocaleDateString(),
            platform: platformName
        }).catch(err => console.error('Failed to send email:', err));

        return res.status(200).json({
            success: true,
            credits_added: result.total_credits_added,
            new_balance: result.new_balance,
            transaction_id: transactionParams.transaction_id
        });

    } catch (error) {
        console.error('❌ Mobile purchase verification error:', error);
        return res.status(500).json({ error: 'Internal server error', details: error.message });
    }
};

// Reused Email Logic (simplified)
async function sendReceiptEmail({ email, name, amount, currency, creditsAdded, transactionId, date, platform }) {
    const symbol = currency === 'USD' ? '$' : '₹';
    const subject = `Receipt for your Citra AI Purchase (${platform}): ${symbol}${amount}`;
    const textBody = `Thank you for your purchase on ${platform}!\nAdded ${creditsAdded} credits.\nTransaction ID: ${transactionId}`;

    // Use shared sendEmail function
    return sendEmail({
        to: email,
        subject,
        text: textBody,
        html: `<p>${textBody.replace(/\n/g, '<br>')}</p>`
    });
}

module.exports = handler;
