const usageTrackingService = require('../services/usageTrackingService');

/**
 * Get Pricing Info - Retrieve current pricing configuration
 * Used by UI to display pricing and by Python service for cost calculation
 * Express handler
 */
const handler = async (req, res) => {
  try {
    // Get pricing info
    const pricing = await usageTrackingService.getPricingInfo();
    
    // Calculate example costs
    const exampleCosts = {
      query_examples: {
        simple_query: {
          description: 'Simple query (500 input + 500 output tokens with Gemini)',
          tokens: 1000,
          cost: (500 / 1000 * pricing.token_pricing.gemini.input_per_1k) + 
                (500 / 1000 * pricing.token_pricing.gemini.output_per_1k)
        },
        complex_query: {
          description: 'Complex query (2000 input + 2000 output tokens with Gemini)',
          tokens: 4000,
          cost: (2000 / 1000 * pricing.token_pricing.gemini.input_per_1k) + 
                (2000 / 1000 * pricing.token_pricing.gemini.output_per_1k)
        },
        image_generation: {
          description: 'Gemini image generation',
          cost: pricing.token_pricing.gemini.image_generation_price
        }
      },
      upload_examples: {
        small_document: {
          description: '10 pages document',
          size_pages: 10,
          cost: 10 * pricing.upload_pricing.document
        },
        large_document: {
          description: '100 pages document',
          size_pages: 100,
          cost: 100 * pricing.upload_pricing.document
        },
        audio_file: {
          description: '5 MB audio file',
          size_mb: 5,
          cost: 5 * pricing.upload_pricing.audio
        },
        video_file: {
          description: '50 MB video file',
          size_mb: 50,
          cost: 50 * pricing.upload_pricing.video
        }
      },
      credit_pack_value: {
        rs_100: {
          amount: 100,
          estimated_queries: Math.floor(100 / 0.01), // ~10,000 simple queries
          estimated_uploads_10pages: Math.floor(100 / (10 * pricing.upload_pricing.document))
        },
        rs_500: {
          amount: 500,
          bonus: pricing.credit_purchase.bonus_tiers.find(t => t.threshold === 500)?.bonus_percentage || 0,
          total_credits: 500 + (500 * (pricing.credit_purchase.bonus_tiers.find(t => t.threshold === 500)?.bonus_percentage || 0) / 100)
        }
      }
    };
    
    console.log('Pricing info retrieved');
    
    return res.status(200).json({
      success: true,
      pricing,
      example_costs: exampleCosts
    });
    
  } catch (error) {
    console.log('Error getting pricing info:', error);
    
    return res.status(500).json({
      error: 'Failed to retrieve pricing information',
      details: error.message
    });
  }
};

module.exports = handler;




