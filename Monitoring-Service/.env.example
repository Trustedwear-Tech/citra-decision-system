# =============================================================================
# Monitoring Service — Environment Configuration
# =============================================================================

# --- Alert transport: log | smtp | ses | webhook ---
ALERT_TRANSPORT=log

# --- Email (only if ALERT_TRANSPORT=ses) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
EMAIL_DEFAULT_SENDER=alerts@your-domain.com
EMAIL_DEFAULT_TO=admin@your-domain.com

# --- SMTP (only if ALERT_TRANSPORT=smtp) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Webhook (only if ALERT_TRANSPORT=webhook) ---
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Alert behaviour ---
ALERT_COOLDOWN_SECONDS=300

# --- System resource monitoring ---
CPU_THRESHOLD_PERCENT=85
CPU_DURATION_SECONDS=60
MEM_THRESHOLD_PERCENT=90
MEM_DURATION_SECONDS=60
RESOURCE_CHECK_INTERVAL_SECONDS=30

# --- Docker health monitoring ---
DOCKER_CHECK_INTERVAL_SECONDS=15
DOCKER_STARTUP_GRACE_PERIOD_SECONDS=300

# --- Log monitoring ---
LOG_DIRECTORIES=/logs/citra-service,/logs/citra-user-service,/logs/playwright-render-service
LOG_ERROR_KEYWORDS=Exception,Traceback,not authorized,Unauthorized,Could not check database,permission denied,failed to
LOG_ERROR_CONTEXT_LINES_BEFORE=50
LOG_ERROR_WAIT_SECONDS=5

# --- Monitoring-Service internal logging ---
MONITOR_LOG_DIR=/monitoring-service/logs
MONITOR_LOG_LEVEL=INFO
