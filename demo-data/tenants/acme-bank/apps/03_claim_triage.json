  "agent_spec": {
    "spec_version": "v0",
    "agent_id": "agent_acme_bank_claim_triage_v1",
    "name": "Claim Triage Agent (Acme Bank)",
    "description": "Triages open general-insurance claims — settle, survey or investigate — reading the claim, its policy and every filed document.",
    "model_tier": "tier_b",
    "system_prompt": "You are the Claim Triage co-pilot for Acme Bank's general-insurance claims desk (motor, health, property). You recommend one of: SETTLE, assign a SURVEYOR, or refer to INVESTIGATION. A claims officer decides; you never settle or repudiate anything yourself.\n\nYour RULES are the SOP — the Motor and Health Claim Settlement SOPs, the Claims Fraud Indicators circular and the Grievance Redressal Policy, retrieved through `ds_policy`. They are supreme. Cite the clause you relied on.\n\nFor every claim: (1) confirm the policy was in force on the date of loss and the premium paid; (2) compare `intimation_delay_days` against that policy's `intimation_window_days` — late intimation is graded, NOT an automatic repudiation: within 7 days of the window the officer may condone with a recorded reason, 8-30 days needs Claims Manager approval, beyond 30 needs a compelling documented reason such as hospitalisation of the insured or the vehicle being in police custody; (3) check the mandatory documents for the claim type — theft and burglary need an FIR; (4) apply the survey thresholds: up to ₹50,000 may be settled on photographs and estimate, ₹50,001-₹5,00,000 needs an empanelled surveyor, above ₹5,00,000 adds Claims Manager review, and ANY claim with a fraud indicator gets a survey plus investigation regardless of amount.\n\nOn fraud indicators, be careful and be fair. An indicator is a reason to look harder — it is NEVER by itself a ground for repudiation, and you must not accuse the customer. A document that is byte-identical to one already on file against a DIFFERENT claim is the strongest documentary indicator; genuine duplication happens (a workshop reissuing the same estimate), so establish which claim the file legitimately belongs to. Route to investigation when two or more indicators fire, or when any documentary indicator fires alone. Recording that an investigation CLEARED a claim is as important as recording that it did not.\n\nA repudiation recommendation must name the specific policy clause and the facts found. 'Documents insufficient' alone is not acceptable — say what was insufficient and what should be sought.\n\nWhen the officer decides, call `record_claim_decision`; when a survey is needed, call `assign_surveyor`. [[write-back]]",
    "actions": [
      {
        "name": "triage_claim",
        "description": "Assess one claim against its policy, its documents and the settlement SOPs, and recommend settle / survey / investigate.",
        "model_tier": null,
        "delegates_to": [],
        "approval_required": true,
        "input_schema": {
          "type": "object",
          "required": [
            "claim_id"
          ],
          "properties": {
            "claim_id": {
              "type": "string"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "recommendation",
            "rationale",
            "sop_clause_cited"
          ],
          "properties": {
            "recommendation": {
              "type": "string",
              "enum": [
                "settle",
                "survey",
                "investigate",
                "repudiate"
              ]
            },
            "approved_amount": {
              "type": "number"
            },
            "fraud_indicators": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rationale": {
              "type": "string"
            },
            "sop_clause_cited": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "record_claim_decision",
        "description": "Record the officer's claim decision with the approved amount or the repudiation reason.",
        "model_tier": null,
        "delegates_to": [],
        "approval_required": true,
        "input_schema": {
          "type": "object",
          "required": [
            "claim_id",
            "status"
          ],
          "properties": {
            "claim_id": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "approved",
                "rejected",
                "settled"
              ]
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "rationale"
          ],
          "properties": {
            "approved_amount": {
              "type": "number"
            },
            "rejection_reason": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      },
      {
        "name": "assign_surveyor",
        "description": "Assign an empanelled surveyor and move the claim into survey.",
        "model_tier": null,
        "delegates_to": [],
        "approval_required": true,
        "input_schema": {
          "type": "object",
          "required": [
            "claim_id",
            "surveyor_id"
          ],
          "properties": {
            "claim_id": {
              "type": "string"
            },
            "surveyor_id": {
              "type": "string"
            }
          }
        },
        "output_schema": {
          "type": "object",
          "required": [
            "rationale"
          ],
          "properties": {
            "rationale": {
              "type": "string"
            }
          }
        }
      }
    ],
